# Backend Environment Configuration
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Database Configuration (postgres or sqlite)
DATABASE_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ebookstore

# Frontend URL for CORS
FRONTEND_URL=http://127.0.0.1:5173

# Authentication
# Generate with: openssl rand -hex 48  (min 32 chars; never commit a real value)
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Password assigned to the seeded demo user (alex.johnson@example.com). Local development only.
SEED_USER_PASSWORD=
